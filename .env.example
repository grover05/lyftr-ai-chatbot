# ==========================================
# Lyftr AI Environment Configuration
# ==========================================

# Comma-separated pool of at least 2 LLM API keys (key_1, key_2, ...)
LLM_API_KEYS=your_key_1_placeholder,your_key_2_placeholder

# SQLite database file URL (use sqlite:////data/app.db in Docker)
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables X-Simulate-Failure request header for key failover demonstration
ENABLE_FAILURE_SIMULATION=true

# Model name supported by LiteLLM (e.g., gemini/gemini-2.0-flash, gpt-4o-mini)
MODEL_NAME=gemini/gemini-2.0-flash

# LiteLLM cache type: disk or local
LITELLM_CACHE_TYPE=disk

# Frontend API base URL (used during frontend build / dev)
VITE_API_BASE_URL=http://localhost:8000
